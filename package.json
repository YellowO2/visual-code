{
  "name": "visual-code",
  "version": "0.1.0",
  "description": "Understand your project visually when coding with AI: a live diagram drawn from the code, and rules a linter checks.",
  "keywords": [
    "architecture",
    "diagram",
    "linter",
    "ai",
    "agents",
    "claude-code",
    "dataflow",
    "visualization"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YellowO2/visual-code.git"
  },
  "type": "module",
  "bin": {
    "visual-code": "src/cli.js"
  },
  "files": [
    "src/",
    "RULES.md",
    "skill/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "esbuild src/view/app.jsx --bundle --minify --format=esm --jsx=automatic --outfile=src/view/app.js"
  },
  "devDependencies": {
    "@xyflow/react": "^12.12.0",
    "elkjs": "^0.12.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
